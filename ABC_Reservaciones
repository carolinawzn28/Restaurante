package jdbc_ejemplo1;

import javax.swing.*;
import java.awt.*;
import java.sql.*;

public class ABC_Reservaciones extends FormularioPadreABC {
    public JTextField txtID, txtHorario, txtNombreReserva;

    public ABC_Reservaciones() {
        super("ABC Reservaciones");
        panelSuperior.setLayout(new GridLayout(3, 2));
        txtID = new JTextField(); txtHorario = new JTextField(); txtNombreReserva = new JTextField();
        panelSuperior.add(new JLabel("IDReserv:")); panelSuperior.add(txtID);
        panelSuperior.add(new JLabel("Horario (YYYY-MM-DD):")); panelSuperior.add(txtHorario);
        panelSuperior.add(new JLabel("IDRol:")); panelSuperior.add(txtNombreReserva);
        this.setSize(400, 150);
    }

    @Override
    public void agregar() {
        try {
            String sql = "INSERT INTO Reservaciones VALUES (" + txtID.getText() + ", '" + txtHorario.getText() + "', " + txtNombreReserva.getText() + ")";
            con.createStatement().executeUpdate(sql);
            JOptionPane.showMessageDialog(null, "Reservación Agendada");
        } catch (Exception ex) { JOptionPane.showMessageDialog(null, "Error: " + ex.toString()); }
    }

    @Override
    public void modificar() {
        try {
            String sql = "UPDATE Reservaciones SET Horario = '" + txtHorario.getText() + "', NombreReserva = " + txtNombreReserva.getText() + " WHERE IDReserv = " + txtID.getText();
            con.createStatement().executeUpdate(sql);
            JOptionPane.showMessageDialog(null, "Reservación Modificada");
        } catch (Exception ex) { JOptionPane.showMessageDialog(null, "Error: " + ex.toString()); }
    }

    @Override
    public void borrar() {
        try {
            String sql = "DELETE FROM Reservaciones WHERE IDReserv = " + txtID.getText();
            con.createStatement().executeUpdate(sql);
            JOptionPane.showMessageDialog(null, "Reservación Eliminada");
        } catch (Exception ex) { JOptionPane.showMessageDialog(null, "Error: " + ex.toString()); }
    }

    @Override
    public void consultar() {
        try {
            String sql = "SELECT * FROM Reservaciones WHERE IDReserv = " + txtID.getText();
            ResultSet rs = con.createStatement().executeQuery(sql);
            if (rs.next()) {
                txtHorario.setText(rs.getString("Horario"));
                txtNombreReserva.setText(rs.getString("Tipo Platillo"));
            } else { JOptionPane.showMessageDialog(null, "Reservación no encontrada."); }
        } catch (Exception ex) { JOptionPane.showMessageDialog(null, "Error: " + ex.toString()); }
    }
}
